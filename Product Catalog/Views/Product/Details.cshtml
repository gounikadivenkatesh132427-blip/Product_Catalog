@model Product_Catalog.Models.Product
@{
    ViewBag.Title = "Details";
}
<h2>Details</h2> 

@if (Model != null)
{
    <dl class="dl-horizontal">
        <dt>Product Id</dt>
        <dd>@Model.ProductId</dd>

        <dt>Product Name</dt>
        <dd>@Model.ProductName</dd>

        <dt>Description</dt>
        <dd>@Model.Description</dd>

        <dt>Price</dt>
        <dd>@string.Format("{0:C}", Model.Price)</dd>

        <dt>Category</dt>
        <dd>@Model.Category</dd>
    </dl>
}
else
{
    <p>Product not found.</p>
}

@Html.ActionLink("Back to Product Catalog", "Index", "Product")


