@model IEnumerable<Product_Catalog.Models.Product>
@using System.Linq
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>
<h2>Gounikadi Venkatesh</h2>
<h2>924001202022</h2>

@if (Model == null || !Model.Any())
{
    <p>No products found.</p>
}
else
{

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Product Id</th>
                <th>Product Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductId</td>
                    <td>@product.ProductName</td>
                    <td>@product.Description</td>
                    <td>@string.Format("{0:C}", product.Price)</td>
                    <td>@product.Category</td>
                    <td>
                        @Html.ActionLink("View Details", "Details", "Product", new { id = product.ProductId }, null)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

